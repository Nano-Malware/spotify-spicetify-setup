; Portable example only. The installer creates the real configuration with
; machine-specific spotify_path and prefs_path values.
; Do not put credentials, tokens, or Spotify prefs in this file.

[AdditionalOptions]
extensions =
custom_apps = marketplace
sidebar_config = 0
home_config = 1
experimental_features = 1

[Setting]
current_theme = marketplace
color_scheme =
inject_css = 1
replace_colors = 1
inject_theme_js = 1

[Preprocesses]
disable_sentry = 1
disable_ui_logging = 1
remove_rtl_rule = 1
expose_apis = 1
